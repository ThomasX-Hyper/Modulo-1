@model IEnumerable<Damers.Models.Producto>
<br>

<table class="table-bordered align-content-center">
    <thead>
        <tr>
            <th>IDProducto</th>
            <th>Nombre</th>
            <th>Modelo</th>
            <th>Color</th>
            <th>Capacidad</th>
            <th>Nombre</th>
            <th>Descripcio</th>

        </tr>
       

    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id_producto</td>
                <td>@item.nombre</td>
                <td>@item.modelo</td>
                <td>@item.color</td>
                <td>@item.capacidad</td>
                <td>@item.TipoProducto.nombre</td>
                <td>@item.TipoProducto.descripcion</td>
            </tr>
            
        }

    </tbody>


</table>